get_helm.sh
.venv
venv

# Credentials. The real file belongs at ~/openegiz-deploy/secrets.values.yaml
# (chmod 600); this guard catches a stray copy inside the checkout.
# secrets.values.yaml.example IS tracked — it holds only CHANGE_ME.
secrets.values.yaml
CREDENTIALS.md

# Compose credentials, generated by scripts/compose-env.sh
deploy/compose/.env
# Set by `make example-mine`: compose commands then include the mine overlay
deploy/compose/.example-mine
# Set by `make up-prod`: compose commands then include the Production Profile overlay
deploy/compose/.prod
# Optional MQTTS certificates for Mosquitto (private keys must never be committed)
deploy/compose/mosquitto/certs/

# services/extended-api build artifacts
services/extended-api/node_modules/
services/extended-api/dist/

__pycache__/
*.pyc

# Demo Unity scene, downloaded by `make unity-demo` (88 MB, lives in a release)
build/WebGL Build.loader.js
build/WebGL Build.framework.js
build/WebGL Build.data
build/WebGL Build.wasm
