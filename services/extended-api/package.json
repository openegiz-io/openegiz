{
  "name": "ditto-extended-api",
  "version": "1.0.0",
  "description": "Extended API for Eclipse Ditto, maintained first-party by OpenEgiz (adopted from ertis-research/extended-api-for-eclipse-ditto)",
  "main": "dist/src/app.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "dev": "nodemon -r dotenv/config src/app.ts",
    "lint": "tsc --noEmit && jest --ci --silent __test__/auth.middleware.test.ts",
    "test:unit": "jest --ci __test__/auth.middleware.test.ts",
    "test:integration": "jest --ci --testPathIgnorePatterns __test__/auth.middleware.test.ts",
    "swagger": "node ./swagger.js"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^0.23.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.1",
    "express-validator": "^7.0.1",
    "jsonschema": "^1.4.0",
    "mongoose": "^6.0.9",
    "swagger-ui-express": "^4.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-promise-router": "^3.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.3",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.6",
    "dotenv": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.13",
    "supertest": "^7.0.0",
    "swagger-autogen": "^2.23.7",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
