# =============================================================================
# OpenEgiz Helm v3 Chart — Secrets override template
# =============================================================================
# Copy outside the repository (never commit filled-in credentials):
#
#   mkdir -p ~/openegiz-deploy
#   cp charts/openegiz/secrets.values.yaml.example ~/openegiz-deploy/secrets.values.yaml
#   chmod 600 ~/openegiz-deploy/secrets.values.yaml
#   # Replace every CHANGE_ME below using: openssl rand -base64 18
#
# Alternatively, create a Kubernetes Secret out-of-band (External Secrets,
# Sealed Secrets, or kubectl) and pass --set credentials.existingSecret=<name>.

credentials:
  dittoPassword: "CHANGE_ME_DITTO_PASSWORD"
  dittoDevopsPassword: "CHANGE_ME_DITTO_DEVOPS_PASSWORD"
  grafanaAdminPassword: "CHANGE_ME_GRAFANA_PASSWORD"
  influxdbAdminPassword: "CHANGE_ME_INFLUXDB_PASSWORD"
  influxdbToken: "CHANGE_ME_INFLUXDB_TOKEN"
  # Required when mosquitto.auth.enabled=true (Production Profile):
  mqttUsername: "openegiz"
  mqttPassword: "CHANGE_ME_MQTT_PASSWORD"
  # Required shared secret when extendedApi.auth.enabled=true:
  extendedApiAuthToken: ""
